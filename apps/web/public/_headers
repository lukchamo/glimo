# Security and caching for everything Workers Static Assets serves directly.
# The Content-Security-Policy must match HTML_CSP in workers/edge/src/security.ts (tested).
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# Fingerprinted files never change: cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The published spec can be fetched from anywhere.
/spec/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
