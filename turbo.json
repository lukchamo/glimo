{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        "scripts/**",
        "index.html",
        "package.json",
        "tsconfig*.json",
        "vite.config.ts"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "test/**",
        "e2e/**",
        "package.json",
        "tsconfig*.json",
        "worker-configuration.d.ts"
      ],
      "outputs": []
    },
    "test": {
      "inputs": [
        "src/**",
        "test/**",
        "bin/**",
        "migrations/**",
        "package.json",
        "vitest.config.ts",
        "wrangler.jsonc",
        "../../spec/**"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
