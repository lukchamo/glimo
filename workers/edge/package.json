{
  "name": "@glimo/edge",
  "version": "0.1.0",
  "private": true,
  "description": "Glimo edge Worker: static site, REST API, live channel (Durable Objects), skills catalog (D1 + Drizzle) and MCP endpoint.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types --include-runtime=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply glimo --local",
    "db:migrate:remote": "wrangler d1 migrations apply glimo --remote"
  },
  "dependencies": {
    "@glimo/spec": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261123.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.166.0"
  }
}
