# Copy to .dev.vars for local development. Never commit .dev.vars.
ID_SECRET=dev-only-secret-change-me
# `wrangler dev` presents requests as the production host, so local browser origins are listed here.
ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,http://localhost:5173

# Notifications (Web Push). Optional: without both keys the feature is off and
# /api/push/key answers 503. Make a pair with `node scripts/gen-vapid.mjs` and paste its
# two lines here. Never commit a real private key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Who push services can contact about this deployment (default: its own address).
# VAPID_SUBJECT=mailto:you@example.com
